generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                @id
  email              String                @unique
  name               String?
  avatarUrl          String?
  memberships        WorkspaceMember[]
  tokens             PersonalAccessToken[]
  projectMemberships ProjectMember[]
  createdProjects    Project[]             @relation("ProjectCreator")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model Workspace {
  id         String            @id @default(cuid())
  clerkOrgId String            @unique
  name       String
  slug       String            @unique
  members    WorkspaceMember[]
  projects   Project[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("org:member")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Project {
  id          String          @id @default(cuid())
  name        String
  workspaceId String
  createdById String
  visibility  String          @default("workspace") // "workspace" | "private"
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id])
  members     ProjectMember[]
  folders     Folder[]
  files       File[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([workspaceId, updatedAt])
}

model Folder {
  id             String   @id @default(cuid())
  projectId      String
  parentId       String?
  name           String
  // D37: normalised lowercase name for case-insensitive uniqueness checks;
  // directoryKey encodes the parent scope so one query proves uniqueness.
  normalizedName String
  directoryKey   String   // "<projectId>:<parentId|ROOT>"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderToFolder")
  files     File[]

  @@unique([directoryKey, normalizedName])
  @@index([projectId])
}

model File {
  id             String   @id @default(cuid())
  projectId      String
  folderId       String?
  name           String
  // D37: normalised lowercase name + directory key for namespace uniqueness
  normalizedName String
  directoryKey   String   // "<projectId>:<folderId|ROOT>"
  type           String
  roomId         String?  @unique   // renamed from liveblocksRoomId; advisory only — Yjs document name is file.id
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder           Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  canvas           CanvasSnapshot?
  document         DocumentSnapshot?

  @@unique([directoryKey, normalizedName])
  @@index([projectId])
}

model CanvasSnapshot {
  fileId       String   @id
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  elements     Json     @default("[]")
  appState     Json     @default("{}")
  elementCount Int      @default(0)
  syncedAt     DateTime @default(now())
}

model DocumentSnapshot {
  fileId    String   @id
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  content   Json     @default("{}")   // ProseMirror JSON — readable, for MCP and search
  yjsUpdate Bytes?                    // native Yjs update — lossless, for seeding
  syncedAt  DateTime @default(now())
}

model ProcessedWebhook {
  id           String    @id
  source       String
  // D44: durable lease columns for at-least-once webhook processing
  status       String    @default("completed")   // "pending" | "processing" | "completed" | "failed"
  leaseUntil   DateTime?
  attemptCount Int       @default(1)
  completedAt  DateTime?
  receivedAt   DateTime  @default(now())

  @@index([receivedAt])
  @@index([status, leaseUntil])
}

model PersonalAccessToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProjectMember {
  projectId String
  userId    String
  role      String   // "owner" | "editor" | "viewer" — opaque string, never an enum
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}
